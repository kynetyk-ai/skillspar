# Anthropic API key — required for running eval suites
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Default model used when not specified in the YAML suite defaults
# SKILLSPAR_MODEL=claude-sonnet-4-5-20250929

# Model used for llm_judge assertions (falls back to SKILLSPAR_MODEL if unset)
# SKILLSPAR_JUDGE_MODEL=claude-sonnet-4-5-20250929

# Directory for auto-named JSON reports (e.g. greeting-skill-basics_20260224-143000.json)
# Files are named from the suite name + UTC timestamp. --output flag overrides with an exact path.
# SKILLSPAR_OUTPUT=./results

# Logging verbosity: DEBUG, INFO, WARNING (default), ERROR
# SKILLSPAR_LOG_LEVEL=WARNING
