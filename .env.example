# Anthropic API key — required for the default anthropic provider
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI(-compatible) API key — required when a suite sets provider: openai
# (a custom var name can be set per-suite via api_key_env)
# OPENAI_API_KEY=sk-...

# Default provider when the suite doesn't set one: anthropic (default) or openai
# SKILLSPAR_PROVIDER=anthropic

# Default API base URL for OpenAI-compatible endpoints (OpenRouter, LiteLLM, Ollama, vLLM)
# SKILLSPAR_BASE_URL=http://localhost:11434/v1

# Default judge provider for llm_judge assertions (falls back to SKILLSPAR_PROVIDER)
# SKILLSPAR_JUDGE_PROVIDER=anthropic

# Default model used when not specified in the YAML suite defaults
# SKILLSPAR_MODEL=claude-sonnet-4-5-20250929

# Model used for llm_judge assertions (falls back to SKILLSPAR_MODEL if unset)
# SKILLSPAR_JUDGE_MODEL=claude-sonnet-4-5-20250929

# Directory for auto-named JSON reports (e.g. greeting-skill-basics_20260224-143000.json)
# Files are named from the suite name + UTC timestamp. --output flag overrides with an exact path.
# SKILLSPAR_OUTPUT=./results

# Logging verbosity: DEBUG, INFO, WARNING (default), ERROR
# SKILLSPAR_LOG_LEVEL=WARNING

# JSON file of model pricing overrides/additions, merged over the builtin table
# (see docs/cli-reference.md for the schema)
# SKILLSPAR_PRICING_FILE=./pricing.json

# Directory for saved snapshots (default: .skillspar/snapshots/). --snapshot-dir overrides.
# SKILLSPAR_SNAPSHOT_DIR=.skillspar/snapshots
